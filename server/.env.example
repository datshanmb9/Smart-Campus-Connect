# ==============================================================================
# SMART CAMPUS CONNECT - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Target Cluster: SmartCampusConnect (MongoDB Atlas)
# ==============================================================================

# Server Network Configuration
# On Render: PORT is injected automatically by Render (do not override)
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://campus_admin:<password>@smartcampuconnect.kfdmzyw.mongodb.net/SmartCampusConnect?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your_cluster_subdomain.mongodb.net/SmartCampusConnect?retryWrites=true&w=majority

# JSON Web Token Secret & Expiration
JWT_SECRET=smart_campus_connect_secret_key_mernova_2026_presidency_university
JWT_EXPIRE=7d

# CORS Allowed Origins
# Comma-separated list of allowed origins.
# In Production: include your Vercel deployment URL (e.g., https://smart-campus-connect.vercel.app)
# Note: Any *.vercel.app domain is also automatically permitted by the server's CORS rules.
CLIENT_URL=https://smart-campus-connect.vercel.app,http://localhost:5173
