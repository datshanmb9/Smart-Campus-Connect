# ==============================================================================
# SMART CAMPUS CONNECT - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to server/.env and fill in your actual credentials.
# NEVER commit real credentials to GitHub.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Database Connection String (DO NOT use local mongodb://)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/smart_campus_connect?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.your_subdomain.mongodb.net/smart_campus_connect?retryWrites=true&w=majority

# JSON Web Token (JWT) Security Configuration
JWT_SECRET=your_super_secret_jwt_key_smart_campus_connect_2026_mernova
JWT_EXPIRE=7d

# Optional Cloudinary Storage Configuration (For Production Image Uploads)
# Can also run in local disk upload mode if Cloudinary is not configured
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

